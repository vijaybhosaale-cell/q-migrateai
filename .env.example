# Copy to .env and fill in. Never commit .env. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"      (or: openssl rand -base64 48)

# --- Website ---
# Your domain (needs a DNS A record pointing at the server). Caddy gets a free HTTPS certificate for it.
SITE_ADDRESS=qmigrate.awhlle.com
PUBLIC_URL=https://qmigrate.awhlle.com
# For a local Docker test on a laptop use instead:  SITE_ADDRESS=:8080   PUBLIC_URL=http://localhost:8080   COOKIE_SECURE=0
COOKIE_SECURE=1

# --- Secrets (required, all different, long and random) ---
SECRET_KEY=change-me-to-a-long-random-value
POSTGRES_PASSWORD=change-me-postgres-admin-password
APP_DB_PASSWORD=change-me-app-password

# --- Data source ---
# public = real data measured live from real organisations' public websites (default).
# simulator = synthetic estates (also set ENABLE_SIMULATOR=1).
DATA_SOURCE=public
PUBLIC_SITES=45

# --- Demo data ---
# Two fictional companies for demonstrations. Set SEED_DEMO=0 before real customers use the server.
SEED_DEMO=1
DEMO_PASSWORD=change-me-Demo2026
ALLOW_SIGNUP=1

# --- Alerts (optional) ---
# Without SMTP the app still records alerts; e-mail copies are logged as "skipped".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@awhlle.com
MONITOR_ENABLED=1

# --- Privacy ---
PRIVACY_CONTACT=privacy@awhlle.com
BACKUP_KEEP_DAYS=14
